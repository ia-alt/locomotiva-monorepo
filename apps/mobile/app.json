{
  "expo": {
    "name": "LocomotivaHub",
    "slug": "locomotiva-mobile-app",
    "scheme": "br.gov.ma.inova.locomotiva",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1C7BFB"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.gov.ma.inova.locomotiva"
    },
    "android": {
      "package": "br.gov.ma.inova.locomotiva",
      "adaptiveIcon": {
        "backgroundColor": "#1C7BFB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "b5279359-b327-42ff-b060-4ef6e11c4748"
      }
    }
  }
}
