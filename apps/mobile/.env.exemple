EXPO_PUBLIC_API_URL=http://192.168.1.12:3000/api
# Para testar no celular (development build): o aparelho não enxerga "localhost".
# Use o IP do Mac na rede (acima) ou a API dev publicada:
# EXPO_PUBLIC_API_URL=https://locomotiva-api-dev.inova.ma.gov.br/api
# O valor é lido quando `npx expo start --dev-client` sobe, não na hora do build.
