DATABASE_URL="postgresql://8c670454727dc2063ef07fca966e5d5e2641dbe96227cb0f4e02c0f6de4705cb:sk_Q2cqOnO7OHQclfyFBIy9e@db.prisma.io:5432/postgres?sslmode=require"
AUTH_JWT_SECRET="string"
RESET_PASSWORD_JWT_SECRET="string"
