# ══════════════ Login Único gov.br (OIDC) ══════════════
# Liga/desliga a integração sem redeploy. Enquanto "false", as rotas do gov.br
# não são montadas e o botão não aparece nos clientes.
GOVBR_ENABLED=false

# Credenciais recebidas da SGD. NUNCA commitar valores reais aqui.
# Atenção: espaço ou quebra de linha no final causa 401 / invalid_client.
GOVBR_CLIENT_ID=
GOVBR_CLIENT_SECRET=

# Homologação: https://sso.staging.acesso.gov.br
# Produção:    https://sso.acesso.gov.br
GOVBR_ISSUER=https://sso.staging.acesso.gov.br

# Precisa ser EXATAMENTE a URL cadastrada na credencial, senão o /token
# devolve invalid_grant. Em produção, obrigatoriamente https.
GOVBR_REDIRECT_URI=http://localhost:3000/auth/govbr/callback

# Separados por espaço. Comece pelo mínimo e adicione conforme a necessidade.
GOVBR_SCOPES=openid email phone profile

# Para onde o gov.br devolve a pessoa após o logout federado. Precisa estar
# cadastrada na credencial (campo "URL de Log Out"). Se vazio, usa a origem
# da GOVBR_REDIRECT_URI.
GOVBR_POST_LOGOUT_REDIRECT_URI=

# Controle da sessão já existente no gov.br (OpenID Connect Core).
# Vazio  = aceita qualquer sessão viva (pessoa não digita senha de novo)
# login  = sempre pede autenticação, ignorando a sessão do gov.br
# Suporte NÃO confirmado no gov.br — teste antes de depender.
GOVBR_PROMPT=
# Alternativa mais branda: aceita a sessão só se autenticou há menos de N segundos
GOVBR_MAX_AGE=
