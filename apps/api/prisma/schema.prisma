// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/modules/_core/infra/database/prisma/client"
}

datasource db {
  provider = "postgresql"
}

// identity context
model User {
  id                      String    @id
  name                    String
  email                   String    @unique
  cpf                     String    @unique
  birthDate               DateTime
  passwordHash            String
  lastPasswordResetDate   DateTime
  passwordResetCode       String?
  passwordResetCodeExpiry DateTime?
  userType                String
  company                 String?
  jobTitle                String?
  phone                   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files File[]

  @@map("users")
}

model ApiKey {
  id      String  @id
  name    String
  keyHash String
  active  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("api_keys")
}

// booking context
model Room {
  id       String  @id
  name     String
  capacity Int
  enabled  Boolean
  photoUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("rooms")
}

model Booking {
  id                    String   @id
  roomId                String
  userId                String
  title                 String
  description           String
  startTime             DateTime
  endTime               DateTime
  status                String
  rejectionCancelReason String?
  numberOfPeople        Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calendarEvent CalendarEvent?

  @@map("bookings")
}

model CalendarEvent {
  id        String @id
  eventId   String
  bookingId String @unique

  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("calendar_events")
}

// coworking context
model CoworkingSettings {
  id       String @id
  capacity Int

  @@map("coworking_settings")
}

model AccessLog {
  id             String    @id
  userId         String
  entryTime      DateTime
  exitTime       DateTime?
  checkinTotemId String?

  @@map("access_logs")
}

// operating-hours context
model SpaceOperatingHours {
  spaceId   String @id
  policies  Json
  overrides Json

  @@map("space_operating_hours")
}

// printing context
model Printer {
  id      String  @id
  name    String
  model   String
  enabled Boolean
  notes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("printers")
}

model Filament {
  id     String  @id
  name   String  @unique
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("filaments")
}

model PrintRequest {
  id                    String  @id
  userId                String
  printerId             String?
  purpose               String
  stlFileId             String  @unique
  gcodeFileId           String  @unique
  filamentId            String
  status                String
  rejectionCancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stlFile   File @relation("StlFile", fields: [stlFileId], references: [id])
  gcodeFile File @relation("GcodeFile", fields: [gcodeFileId], references: [id])

  @@map("print_requests")
}

// storage context
model File {
  id               String  @id
  name             String
  path             String
  sizeBytes        Int
  deleted          Boolean @default(false)
  uploadedByUserId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  uploadedByUser    User          @relation(fields: [uploadedByUserId], references: [id])
  printRequestStl   PrintRequest? @relation("StlFile")
  printRequestGcode PrintRequest? @relation("GcodeFile")

  @@map("files")
}
