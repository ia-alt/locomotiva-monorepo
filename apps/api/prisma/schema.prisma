// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/modules/_core/infra/database/prisma/client"
}

datasource db {
  provider = "postgresql"
}

// identity context
model User {
  id                    String   @id
  name                  String
  email                 String   @unique
  cpf                   String?  @unique
  birthDate             DateTime
  passwordHash          String
  lastPasswordResetDate DateTime
  userType              String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// booking context
model Room {
  id       String  @id
  name     String
  capacity Int
  enabled  Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("rooms")
}

model Booking {
  id                    String   @id
  roomId                String
  userId                String
  title                 String
  description           String
  startTime             DateTime
  endTime               DateTime
  status                String
  rejectionCancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bookings")
}

// coworking context
model CoworkingSettings {
  id       String @id
  capacity Int

  @@map("coworking_settings")
}

model AccessLog {
  id        String    @id
  userId    String
  entryTime DateTime
  exitTime  DateTime?

  @@map("access_logs")
}

// operating-hours context
model SpaceOperatingHours {
  spaceId   String @id
  policies  Json
  overrides Json

  @@map("space_operating_hours")
}
