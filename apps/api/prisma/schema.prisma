// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/modules/_core/infra/database/prisma/client"
}

datasource db {
  provider = "postgresql"
}

// identity context
model User {
  id                      String    @id
  name                    String
  email                   String    @unique
  cpf                     String    @unique
  birthDate               DateTime
  passwordHash            String?
  lastPasswordResetDate   DateTime
  passwordResetCode       String?
  passwordResetCodeExpiry DateTime?
  userType                String
  company                 String?
  jobTitle                String?
  phone                   String?

  // Login Único gov.br. authProvider = "local" | "govbr".
  // govbrSub guarda o claim `sub` bruto do id_token, tratado como string opaca
  // (o formato não é garantido pelo provedor — ver GOVBR-LOGIN-UNICO.md §3).
  authProvider String  @default("local")
  govbrSub     String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files         File[]
  refreshTokens RefreshToken[]

  @@map("users")
}

/// Sessão persistente ("continuar conectado") — padrão refresh token com rotação.
///
/// O token em si NUNCA é guardado: só o sha256 (`tokenHash`), como no ApiKey.
/// Cada uso rotaciona — o antigo ganha `usedAt` e um novo nasce na mesma
/// `familyId` (a família É a sessão, do login ao logout). Apresentar um token
/// já usado indica vazamento e revoga a família inteira. O logout marca
/// `revokedAt` em toda a família, matando a sessão no servidor de verdade —
/// coisa que o JWT de acesso sozinho não permite.
model RefreshToken {
  id        String    @id
  tokenHash String    @unique
  userId    String
  familyId  String
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model ApiKey {
  id      String  @id
  name    String
  keyHash String
  active  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("api_keys")
}

/// Estado de um login gov.br em andamento, entre o /authorize e o /callback.
///
/// Existe porque o fluxo OIDC é stateful e o projeto não tem sessão nem cookie:
/// o `state` prova que a resposta corresponde a um pedido nosso (anti-CSRF), o
/// `nonce` prova que o id_token é desta rodada (anti-replay) e o `codeVerifier`
/// é o segredo do PKCE, que NUNCA pode ir para o navegador.
///
/// `usedAt` garante uso único: sem isso, um `code` interceptado poderia ser
/// trocado de novo. `expiresAt` limita a janela de ataque e permite expurgo.
///
/// Só o app mobile usa gov.br; o admin continua com login por senha. Por isso
/// não há coluna de "cliente de origem" — o retorno sempre cai no mesmo lugar.
model GovbrAuthRequest {
  state        String    @id
  nonce        String
  codeVerifier String
  /// Caminho relativo interno para onde levar o usuário depois do login.
  redirectTo   String?
  expiresAt    DateTime
  usedAt       DateTime?

  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("govbr_auth_requests")
}

/// Identidade já validada no gov.br, aguardando um segundo passo do usuário:
/// provar posse da conta local existente, ou informar os dados que o gov.br
/// não fornece (data de nascimento e telefone).
///
/// Existe porque o `code` do gov.br é de uso único e já foi consumido quando
/// descobrimos que falta esse passo. Sem este comprovante de curta duração, a
/// segunda chamada não teria como provar que a pessoa autenticou de verdade —
/// e aceitar um CPF cru vindo do cliente seria o mesmo que não ter login.
///
/// Guardado no servidor, e não num token entregue ao navegador, para não
/// espalhar dado pessoal e para permitir invalidação por uso único.
model GovbrPendingIdentity {
  id       String  @id
  govbrSub String
  cpf      String
  name     String
  email    String?
  picture  String?

  redirectTo String?
  expiresAt  DateTime
  usedAt     DateTime?

  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("govbr_pending_identities")
}

// booking context
model Room {
  id          String  @id
  name        String
  capacity    Int
  enabled     Boolean
  photoUrl    String?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("rooms")
}

model Booking {
  id                    String   @id
  roomId                String
  userId                String
  title                 String
  description           String
  startTime             DateTime
  endTime               DateTime
  status                String
  rejectionCancelReason String?
  numberOfPeople        Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calendarEvent CalendarEvent?

  @@map("bookings")
}

model CalendarEvent {
  id        String @id
  eventId   String
  bookingId String @unique

  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("calendar_events")
}

// coworking context
model CoworkingSettings {
  id       String @id
  capacity Int

  @@map("coworking_settings")
}

model AccessLog {
  id             String    @id
  userId         String
  entryTime      DateTime
  exitTime       DateTime?
  checkinTotemId String?

  @@map("access_logs")
}

// operating-hours context
model SpaceOperatingHours {
  spaceId   String @id
  policies  Json
  overrides Json

  @@map("space_operating_hours")
}

// printing context
model Printer {
  id      String  @id
  name    String
  model   String
  enabled Boolean
  notes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("printers")
}

model Filament {
  id     String  @id
  name   String  @unique
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("filaments")
}

model PrintRequest {
  id                    String  @id
  userId                String
  printerId             String?
  purpose               String
  stlFileId             String  @unique
  gcodeFileId           String  @unique
  filamentId            String
  status                String
  rejectionCancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stlFile   File @relation("StlFile", fields: [stlFileId], references: [id])
  gcodeFile File @relation("GcodeFile", fields: [gcodeFileId], references: [id])

  @@map("print_requests")
}

// storage context
model File {
  id               String  @id
  name             String
  path             String
  sizeBytes        Int
  deleted          Boolean @default(false)
  uploadedByUserId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  uploadedByUser    User          @relation(fields: [uploadedByUserId], references: [id])
  printRequestStl   PrintRequest? @relation("StlFile")
  printRequestGcode PrintRequest? @relation("GcodeFile")

  @@map("files")
}
