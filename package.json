{
  "name": "locomotiva-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start:api": "npm run prisma:deploy -w @locomotiva/api && npm start -w @locomotiva/api",
    "dev:api": "npm run dev -w @locomotiva/api",
    "dev:mobile": "npm run dev -w @locomotiva/mobile",
    "dev:admin": "npm run dev -w @locomotiva/admin",
    "build:api": "npm run build -w @locomotiva/api",
    "build:admin": "npm run build -w @locomotiva/admin",
    "build:mobile": "npm run build -w @locomotiva/mobile",
    "build:tablet": "npm run build -w @locomotiva/tablet",
    "prisma:studio": "npm run prisma:studio -w @locomotiva/api",
    "dev:tablet": "npm run dev -w @locomotiva/tablet",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:mobile\"",
    "promote-to-admin": "npm run promote-to-admin -w @locomotiva/api --"
  },
  "dependencies": {
    "react-native-worklets": "^0.7.4",
    "react-native-worklets-core": "^1.6.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": "24.x"
  }
}
